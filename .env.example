# Copy to .env; configure credentials privately. Never commit real secrets.
OUTPUT_DELIVERY_PROVIDER=huggingface
HF_ASSET_BUCKET=seachen/modal-vllm-sglang-assets

# Optional download override: auto or 1-8. Unset uses model defaults.
# MODEL_HF_DOWNLOAD_WORKERS=auto

# Optional credentials for local migration and setup-secrets scripts.
# HF_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# HF_S3_ACCESS_KEY_ID=
# HF_S3_SECRET_ACCESS_KEY=
# GITHUB_TOKEN=
# OWNER_PASSWORD=
# DOWNLOAD_SECRET=
# R2_IMPORT_KEY=

# Sole HF delivery protocol (automatic for all new HF scenes)
# DELIVERY_V3_VOLUME_NAME=delivery-store
# DELIVERY_V3_APP_NAME=modal-vllm-sglang-delivery-v3
# DELIVERY_V3_REGION=auto
# DELIVERY_V3_SCHEDULE=1
# DELIVERY_V3_MEDIA_SCALEDOWN=60
