{
  "volume_name": "model-store",
  "download_workers": 5,
  "revision": "main",
  "gpu": "RTX-PRO-6000",
  "cpu": 4,
  "memory": 8192,
  "port": 8000,
  "timeout": 14400,
  "startup_timeout": 3600,
  "scaledown_window": 30,
  "memory_snapshot": "gpu",
  "service": "moss",
  "app_name": "001-moss-image",
  "operation": "t2i",
  "kind": "image",
  "model": "OpenMOSS-Team/MOSS-Image-SFT",
  "image": "debian_slim",
  "python_version": "3.12",
  "uv_packages": [
    "vllm==0.32.0",
    "vllm-omni==0.32.0"
  ],
  "uv_torch_backend": "cu130",
  "build_commands": ["flashinfer install-cubin-wheel", "flashinfer install-jit-cache-wheel --cuda-version 13.0 --mode minimal --sm sm120"],
  "command": [
    "vllm",
    "serve",
    "{model_path}",
    "--served-model-name",
    "{model}",
    "--omni",
    "--enforce-eager",
    "--host",
    "0.0.0.0",
    "--port",
    "{port}"
  ],
  "defaults": {
    "size": "1024x1024",
    "n": 1,
    "num_inference_steps": 50,
    "guidance_scale": 3.0,
    "flow_shift": 5.0,
    "response_format": "b64_json",
    "extra_params": {
      "uncond_skip_layers": [
        22
      ],
      "slg_start": 0.01,
      "slg_stop": 1.0
    }
  },
  "options": {
    "size": {
      "type": "string",
      "pattern": "[1-9][0-9]*x[1-9][0-9]*"
    },
    "num_inference_steps": {
      "type": "integer",
      "minimum": 1
    },
    "guidance_scale": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 999
    },
    "flow_shift": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 999
    }
  },
  "validator": "moss",
  "validator_module": "models.001-moss-image.model_impl.params",
  "cache": {
    "mode": "hf",
    "required_files": [
      "model_index.json"
    ]
  },
  "cache_directory": "/data/models/001-moss-image",
  "endpoint_label": "001-moss-image-serve",
  "modal_class": "Moss",
  "service_directory": "001-moss-image"
}
