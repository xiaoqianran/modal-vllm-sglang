{
  "volume_name": "model-store",
  "download_workers": 6,
  "revision": "5f90473023975e6271b0ed1dd84c4e88e4bbc6d3",
  "gpu": "RTX-PRO-6000",
  "cpu": 4,
  "memory": 32768,
  "port": 30000,
  "proxy_port": 30020,
  "timeout": 14400,
  "startup_timeout": 3600,
  "scaledown_window": 60,
  "memory_snapshot": "gpu",
  "snapshot_warmup": {
    "params": {"size": "2048x1152", "num_inference_steps": 6}
  },
  "service": "minimax",
  "app_name": "005-minimax-h3-image",
  "operation": "t2i",
  "kind": "image",
  "model": "MiniMaxAI/MiniMax-H3-Image",
  "image": "debian_slim",
  "uv_packages": [
    "sglang[diffusion] @ https://github.com/sgl-project/whl/releases/download/nightly-2026-11-24-1173264b58/sglang-0.5.24.dev20261124%2Bg1173264b58-cp312-cp312-manylinux_2_39_x86_64.whl#sha256=3c4e8dfb13c18bf3bf685f9029c0143a9ae74fe5c4124e7076f558f0ed2e6596"
  ],
  "command": [
    "python",
    "-m",
    "sglang.multimodal_gen.runtime.entrypoints.cli.main",
    "serve",
    "--model-path",
    "{model_path}",
    "--text-encoder-path",
    "{encoder_path}/text_encoder",
    "--host",
    "0.0.0.0",
    "--port",
    "{port}",
    "--warmup-mode",
    "off"
  ],
  "defaults": {
    "size": "2048x1152",
    "num_inference_steps": 6,
    "generator_device": "cpu",
    "response_format": "b64_json"
  },
  "options": {
    "size": {
      "type": "string",
      "pattern": "[1-9][0-9]*x[1-9][0-9]*"
    },
    "num_inference_steps": {
      "type": "integer",
      "enum": [
        6
      ]
    },
    "min_generation_area": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 16777216
    }
  },
  "validator": "minimax",
  "validator_module": "models.005-minimax-h3-image.model_impl.params",
  "cache": {
    "mode": "hf",
    "allow_patterns": [
      "model_index.json",
      "pdd_config.json",
      "pdd_fused_heads.safetensors",
      "transformer/*",
      "vae/*",
      "tokenizer/*",
      "processor/*"
    ],
    "required_files": [
      "model_index.json",
      "pdd_config.json",
      "pdd_fused_heads.safetensors",
      "transformer/*.safetensors",
      "vae/*.safetensors"
    ]
  },
  "components": {
    "encoder": {
      "model": "MiniMaxAI/MiniMax-H3",
      "revision": "0919fb684102ef115126612f3fbb84d1027e7317",
      "allow_patterns": [
        "text_encoder/*"
      ],
      "required_files": [
        "text_encoder/*.safetensors"
      ]
    }
  },
  "cache_directory": "/data/models/005-minimax-h3-image",
  "endpoint_label": "005-minimax-h3-image-serve",
  "modal_class": "H3",
  "service_directory": "005-minimax-h3-image",
  "python_version": "3.12",
  "uv_torch_backend": "cu130",
  "uv_extra_index_url": "https://docs.sglang.ai/whl/cu130/",
  "uv_only_binary": true,
  "env": {
    "CUDA_HOME": "/usr/local/lib/python3.12/site-packages/nvidia/cu13"
  },
  "build_commands": [
    "set -e; CUDA_ROOT=/usr/local/lib/python3.12/site-packages/nvidia/cu13; test -f \"$CUDA_ROOT/lib/libcudart.so.13\"; test -e \"$CUDA_ROOT/lib64\" || ln -s lib \"$CUDA_ROOT/lib64\"; test -e \"$CUDA_ROOT/lib/libcudart.so\" || ln -s libcudart.so.13 \"$CUDA_ROOT/lib/libcudart.so\"; test -f \"$CUDA_ROOT/lib64/libcudart.so\""
  ]
}
