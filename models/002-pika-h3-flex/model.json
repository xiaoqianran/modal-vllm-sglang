{
  "volume_name": "model-store",
  "download_workers": "auto",
  "revision": "main",
  "gpu": "RTX-PRO-6000",
  "cpu": 4,
  "memory": 49152,
  "port": 30010,
  "timeout": 14400,
  "startup_timeout": 3600,
  "scaledown_window": 60,
  "memory_snapshot": "gpu",
  "service": "pika",
  "app_name": "002-pika-h3-flex",
  "operation": "t2va",
  "kind": "video",
  "model": "Pika-Labs/Pika-H3-Flex",
  "image": "debian_slim",
  "proxy_port": 30020,
  "frame_transport": "keyframes",
  "command": [
    "python",
    "-m",
    "sglang.multimodal_gen.runtime.entrypoints.cli.main",
    "serve",
    "--model-path",
    "{model_path}",
    "--host",
    "127.0.0.1",
    "--port",
    "{port}",
    "--performance-mode",
    "memory",
    "--layerwise-offload-components",
    "text_encoder,vae",
    "--layerwise-resident-layers",
    "video_vae=36",
    "--warmup-resolutions",
    "864x480"
  ],
  "defaults": {
    "task": "t2va",
    "seconds": 5,
    "num_inference_steps": 6,
    "num_outputs_per_prompt": 1,
    "conditions": [],
    "target": {
      "short_edge": 480,
      "aspect_ratio": "auto",
      "duration_seconds": 5.0
    }
  },
  "operations": {
    "t2va": {
      "defaults": {
        "task": "t2va"
      }
    },
    "fl2va": {
      "defaults": {
        "task": "fl2va"
      },
      "inputs": {
        "prompt": "string",
        "first_frame": "image",
        "last_frame": "image"
      }
    }
  },
  "options": {
    "seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 15
    },
    "num_inference_steps": {
      "type": "integer",
      "enum": [
        6
      ]
    },
    "target": {
      "type": "object"
    }
  },
  "validator": "pika",
  "validator_module": "models.002-pika-h3-flex.model_impl.params",
  "cache_implementation": "models.002-pika-h3-flex.model_impl",
  "cache": {
    "mode": "sglang_overlay",
    "required_files": [
      "model_index.json",
      ".sglang_overlay_materialized.json"
    ]
  },
  "cache_directory": "/data/models/002-pika-h3-flex",
  "endpoint_label": "002-pika-h3-flex-serve",
  "modal_class": "Pika",
  "resolution_profiles": {
    "480p": {
      "16:9": [
        864,
        480
      ],
      "9:16": [
        480,
        864
      ],
      "4:3": [
        640,
        480
      ],
      "3:4": [
        480,
        640
      ],
      "1:1": [
        480,
        480
      ]
    },
    "768p": {
      "16:9": [
        1344,
        768
      ]
    }
  },
  "service_directory": "002-pika-h3-flex",
  "python_version": "3.12",
  "uv_packages": [
    "sglang[diffusion] @ https://github.com/sgl-project/whl/releases/download/nightly-2026-11-24-1173264b58/sglang-0.5.24.dev20261124%2Bg1173264b58-cp312-cp312-manylinux_2_39_x86_64.whl#sha256=3c4e8dfb13c18bf3bf685f9029c0143a9ae74fe5c4124e7076f558f0ed2e6596"
  ],
  "uv_torch_backend": "cu130",
  "uv_extra_index_url": "https://docs.sglang.ai/whl/cu130/",
  "uv_only_binary": true,
  "env": {
    "CUDA_HOME": "/usr/local/lib/python3.12/site-packages/nvidia/cu13"
  },
  "build_commands": [
    "set -e; CUDA_ROOT=/usr/local/lib/python3.12/site-packages/nvidia/cu13; test -f \"$CUDA_ROOT/lib/libcudart.so.13\"; test -e \"$CUDA_ROOT/lib64\" || ln -s lib \"$CUDA_ROOT/lib64\"; test -e \"$CUDA_ROOT/lib/libcudart.so\" || ln -s libcudart.so.13 \"$CUDA_ROOT/lib/libcudart.so\"; test -f \"$CUDA_ROOT/lib64/libcudart.so\"",
    "apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*"
  ]
}
