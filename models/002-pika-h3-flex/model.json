{
  "volume_name": "model-store",
  "download_workers": 5,
  "revision": "main",
  "gpu": "RTX-PRO-6000",
  "cpu": 4,
  "memory": 49152,
  "port": 30010,
  "timeout": 14400,
  "startup_timeout": 3600,
  "scaledown_window": 30,
  "memory_snapshot": "gpu",
  "service": "pika",
  "app_name": "002-pika-h3-flex",
  "operation": "t2va",
  "kind": "video",
  "model": "Pika-Labs/Pika-H3-Flex",
  "image": "lmsysorg/sglang@sha256:56e4024e21c35266192fd4c3313f39960156fcee1bee6aa8aab293e65131d838",
  "proxy_port": 30020,
  "frame_transport": "keyframes",
  "command": [
    "python",
    "-m",
    "sglang.multimodal_gen.runtime.entrypoints.cli.main",
    "serve",
    "--model-path",
    "{model_path}",
    "--host",
    "127.0.0.1",
    "--port",
    "{port}",
    "--performance-mode",
    "memory",
    "--layerwise-offload-components",
    "text_encoder,vae",
    "--layerwise-resident-layers",
    "video_vae=36"
  ],
  "defaults": {
    "task": "t2va",
    "seconds": 5,
    "num_inference_steps": 6,
    "num_outputs_per_prompt": 1,
    "conditions": [],
    "target": {
      "short_edge": 480,
      "aspect_ratio": "auto",
      "duration_seconds": 5.0
    }
  },
  "operations": {
    "t2va": {
      "defaults": {
        "task": "t2va"
      }
    },
    "fl2va": {
      "defaults": {
        "task": "fl2va"
      },
      "inputs": {
        "prompt": "string",
        "first_frame": "image",
        "last_frame": "image"
      }
    }
  },
  "options": {
    "seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 15
    },
    "num_inference_steps": {
      "type": "integer",
      "enum": [
        6
      ]
    },
    "target": {
      "type": "object"
    }
  },
  "validator": "pika",
  "validator_module": "models.002-pika-h3-flex.model_impl.params",
  "cache_implementation": "models.002-pika-h3-flex.model_impl",
  "cache": {
    "mode": "sglang_overlay",
    "required_files": [
      "model_index.json",
      ".sglang_overlay_materialized.json"
    ]
  },
  "cache_directory": "/data/models/002-pika-h3-flex",
  "endpoint_label": "002-pika-h3-flex-serve",
  "modal_class": "Pika",
  "resolution_profiles": {
    "480p": {
      "16:9": [
        864,
        480
      ],
      "9:16": [
        480,
        864
      ],
      "4:3": [
        640,
        480
      ],
      "3:4": [
        480,
        640
      ],
      "1:1": [
