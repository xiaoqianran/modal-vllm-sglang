{
  "service": "qwen38-pi",
  "download_workers": 2,
  "download_policy": "archived",
  "kind": "llm",
  "operation": "chat",
  "model": "Qwen/Qwen3.8-27B",
  "revision": "main",
  "image": "vllm/vllm-openai@sha256:cf5b2fdd087eb4f6d261736967cc5cde974bd22ff4df50365f8fa419b6b4c484",
  "build_commands": ["ln -sf /usr/bin/python3 /usr/local/bin/python"],
  "env": {
    "VLLM_CACHE_ROOT": "/data/models/qwen38-pi/engine-cache/v0.34.0/vllm",
    "VLLM_ENABLE_STARTUP_PLAN": "1"
  },
  "gpu": "RTX-PRO-6000",
  "cpu": 8,
  "memory": 32768,
  "port": 8000,
  "startup_timeout": 3600,
  "timeout": 14400,
  "scaledown_window": 360,
  "memory_snapshot": "off",
  "app_name": "modal-model-qwen38-pi",
  "modal_class": "Qwen38Pi",
  "endpoint_label": "qwen38-pi-serve",
  "api_key_secret": "modal-qwen38-27B-pi",
  "cache_directory": "/data/models/qwen38-pi",
  "cache": {
    "mode": "hf",
    "required_files": [
      "config.json",
      "*.safetensors"
    ]
  },
  "components": {
    "adapter": {
      "model": "harness-hub/Qwen3.8-27B-pi-adapted",
      "revision": "main",
      "required_files": [
        "adapter_config.json",
        "adapter_model.safetensors"
      ]
    }
  },
  "command": [
    "vllm",
    "serve",
    "{model_path}",
    "--host",
    "0.0.0.0",
    "--port",
    "{port}",
    "--served-model-name",
    "qwen3.8-27B",
    "--enable-lora",
    "--max-lora-rank",
    "32",
    "--lora-modules",
    "qwen3.8-27B-pi={adapter_path}",
    "--language-model-only",
    "--enable-prefix-caching",
    "--mamba-cache-mode",
    "align",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_xml",
    "--reasoning-parser",
    "qwen3",
    "--default-chat-template-kwargs",
    "{\"enable_thinking\":false}",
    "--max-num-seqs",
    "8",
    "--max-model-len",
    "131072"
  ]
}
