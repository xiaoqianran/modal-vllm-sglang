      "endpoint_env": "MINIMAX_ENDPOINT",
      "revision": "minimax-h3-image-r1",
      "headers_env": {
        "Modal-Key": "MINIMAX_MODAL_KEY",
        "Modal-Secret": "MINIMAX_MODAL_SECRET"
      }
    },
    "moss": {
      "endpoint_env": "MOSS_ENDPOINT",
