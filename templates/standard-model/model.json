{
  "service": "REPLACE_SERVICE",
  "operation": "t2i",
  "kind": "image",
  "model": "REPLACE_MODEL_REPOSITORY",
  "revision": "REPLACE_WITH_COMMIT_BRANCH_OR_TAG",
  "image": "REPLACE_CONTAINER_IMAGE_WITH_DIGEST",
  "command": ["sglang", "serve", "--model-path", "{model_path}", "--host", "0.0.0.0", "--port", "{port}"],
  "defaults": {"response_format": "b64_json"},
  "options": {"num_inference_steps": {"type": "integer", "minimum": 1}},
  "port": 8000,
  "gpu": "RTX-PRO-6000"
}
